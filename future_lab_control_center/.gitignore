# 1. Ambientes e Segredos (NUNCA subir pro Git)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.agent_token
*.pem
*.key
*.cert

# 2. Python (Backend & Scripts)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/

# 3. Node.js & Web (Frontend Next.js/React)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 4. ROS 2 & Logs de Execução
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
*.bag
*.db3
*.db3-wal
*.db3-shm

# 5. Sistema Operacional & IDEs
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
/tmp/
